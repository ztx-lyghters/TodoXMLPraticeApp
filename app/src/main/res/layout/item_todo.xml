<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:maxHeight="100dp"
    android:padding="16dp"
    android:clickable="true"
    android:focusable="true"
    xmlns:tools="http://schemas.android.com/tools">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutTodoItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tvTodoTitle"
            android:layout_height="wrap_content"
            android:layout_width="0dp"
            android:gravity="center_vertical"
            android:lines="2"
            android:textSize="24sp"
            app:layout_constraintBottom_toBottomOf="@id/layoutTodoItem"
            app:layout_constraintEnd_toStartOf="@+id/cbTodoDone"
            app:layout_constraintStart_toStartOf="@id/layoutTodoItem"
            app:layout_constraintTop_toTopOf="@id/layoutTodoItem"
            tools:text="TODO text" />

        <CheckBox
            android:id="@+id/cbTodoDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:scaleX="1.3"
            android:scaleY="1.3"
            app:layout_constraintBottom_toBottomOf="@id/layoutTodoItem"
            app:layout_constraintEnd_toEndOf="@id/layoutTodoItem"
            app:layout_constraintTop_toTopOf="@id/layoutTodoItem" />
    </androidx.constraintlayout.widget.ConstraintLayout>


</androidx.constraintlayout.widget.ConstraintLayout>